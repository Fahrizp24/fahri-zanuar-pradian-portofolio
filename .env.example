# Portfolio chatbot (app/api/chat/route.ts)
# Set these in Vercel: Project Settings -> Environment Variables.
# Without GEMINI_API_KEY the chatbot still works in local fallback mode,
# answering from lib/chatbot-knowledge.ts only.
GEMINI_API_KEY=
# Optional. Defaults to gemini-3.5-flash.
GEMINI_MODEL=gemini-3.5-flash
