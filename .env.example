# Portfolio chatbot (app/api/chat/route.ts)
# Set these in Vercel: Project Settings -> Environment Variables.
# Engine order: Sumopod (default) -> Gemini (fallback) -> local mode.
# Sumopod: one key; the model is pinned in code to hy4-flash.
SUMOPOD_API_KEY=
# Gemini fallback: three keys, tried in this order: DOREMIANJAY first,
# ZANUARFAHRI and FPRADIAN24 after it (10 seconds per attempt).
# The Gemini model is pinned in code to gemini-3.5-flash.
# There is no GEMINI_MODEL / SUMOPOD_MODEL setting: neither engine
# can be overridden in Vercel.
GEMINI_API_KEY_DOREMIANJAY=
GEMINI_API_KEY_ZANUARFAHRI=
GEMINI_API_KEY_FPRADIAN24=
# Without any key the chatbot still works in local fallback mode,
# answering from lib/chatbot-knowledge.ts only.
