# Portfolio chatbot (app/api/chat/route.ts)
# Set these in Vercel: Project Settings -> Environment Variables.
# Three Gemini keys, tried in this order: DOREMIANJAY is the default,
# ZANUARFAHRI and FPRADIAN24 are fallbacks (10 seconds per attempt).
# Without any key the chatbot still works in local fallback mode,
# answering from lib/chatbot-knowledge.ts only.
GEMINI_API_KEY_DOREMIANJAY=
GEMINI_API_KEY_ZANUARFAHRI=
GEMINI_API_KEY_FPRADIAN24=
# The model is pinned in code to gemini-3.5-flash (the main engine).
# There is no GEMINI_MODEL setting: it cannot be overridden in Vercel.
